<Window x:ConnectionId='1'
    x:Class="Alfred.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Alfred.UI.Pages"
    Title="Alfred - Asistente IA Local">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de estado del backend -->
        <Grid Grid.Row="0" Padding="12,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Alfred" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <Border x:ConnectionId='6' x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" />
                <TextBlock x:ConnectionId='7' x:Name="StatusText" Text="Iniciando..." FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
                <TextBlock x:ConnectionId='4' x:Name="ModelName" Text="" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           MaxWidth="250" TextTrimming="CharacterEllipsis"
                                                                                         />
                <Button x:ConnectionId='5' x:Name="RestartButton" Content="Reiniciar"                         
                        Style="{StaticResource AccentButtonStyle}" Padding="8,4" FontSize="11"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navegacion con panel lateral -->
        <NavigationView x:ConnectionId='2' x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneOpen="True"
                                                              >

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chat" Tag="chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Conversaciones" Tag="conversations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historial" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Documentos" Tag="documents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Modelos" Tag="models">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Configuracion" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:ConnectionId='3' x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

