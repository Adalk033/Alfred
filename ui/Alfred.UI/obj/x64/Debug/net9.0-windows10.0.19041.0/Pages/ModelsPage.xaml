<Page
    x:Class="Alfred.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Modelos GGUF" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,16" />

            <!-- Estado actual -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Estado actual" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="LLM" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:ConnectionId='22' x:Name="LlmStatus" Text="Cargando..." FontSize="13" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buscar y descargar modelo desde HuggingFace -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Descargar modelo desde HuggingFace" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Pega la URL o nombre del modelo (ej. google/gemma-3-4b-it, openai/gpt-oss-20b) y se buscaran las versiones GGUF disponibles."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Barra de busqueda -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:ConnectionId='20' x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="google/gemma-3-4b-it  o  https://huggingface.co/openai/gpt-oss-20b"
                                 VerticalAlignment="Center"
                                                           />

                        <Button x:ConnectionId='21' x:Name="SearchButton" Grid.Column="1" Content="Buscar GGUF"
                                                      Padding="12,6"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Indicador de busqueda -->
                    <ProgressBar x:ConnectionId='6' x:Name="SearchProgress" IsIndeterminate="True"
                                 Height="4" Visibility="Collapsed" />
                    <TextBlock x:ConnectionId='7' x:Name="SearchStatusText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />

                    <!-- Resultados: Lista de repos encontrados -->
                    <StackPanel x:ConnectionId='8' x:Name="RepoResultsPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:ConnectionId='18' x:Name="RepoResultsHeader" Text="Repositorios GGUF encontrados:"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ListView x:ConnectionId='19' x:Name="RepoListView" SelectionMode="Single"
                                                                    MaxHeight="140" />
                    </StackPanel>

                    <!-- Archivos GGUF del repo seleccionado -->
                    <StackPanel x:ConnectionId='9' x:Name="FileResultsPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:ConnectionId='14' x:Name="FileResultsHeader" Text="Archivos disponibles:"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ListView x:ConnectionId='15' x:Name="FileListView" SelectionMode="None" MaxHeight="350">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Quantization}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding SizeGb}" />
                                            <Run Text=" GB" />
                                        </TextBlock>

                                        <Button x:ConnectionId='17' Grid.Column="2" Content="Descargar"
                                                                          
                                                Tag="{Binding}"
                                                Padding="10,4" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Progreso de descarga -->
                    <ProgressBar x:ConnectionId='10' x:Name="DownloadProgressBar" Minimum="0" Maximum="100"
                                 Height="4" Visibility="Collapsed" />
                    <TextBlock x:ConnectionId='11' x:Name="DownloadProgressText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <Button x:ConnectionId='12' x:Name="CancelDownloadButton" Content="Cancelar descarga"
                                                     Padding="10,4"
                            Visibility="Collapsed" />

                    <TextBlock x:ConnectionId='13' x:Name="ModelsDirText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Lista de modelos disponibles en disco -->
            <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="Modelos disponibles en disco" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>

            <ListView x:ConnectionId='2' x:Name="ModelListView" Grid.Row="4" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Path}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding SizeGb}" />
                                <Run Text=" GB" />
                            </TextBlock>

                            <Button x:ConnectionId='5' Grid.Column="2" Content="Usar como LLM"
                                                          Tag="{Binding Path}"
                                    Padding="12,4" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:ConnectionId='3' x:Name="EmptyText" Grid.Row="4"
                       Text="No se encontraron archivos GGUF en disco"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />
        </Grid>
    </ScrollViewer>
</Page>

