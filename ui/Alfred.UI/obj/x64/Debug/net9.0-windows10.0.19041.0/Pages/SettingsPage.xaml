<Page
    x:Class="Alfred.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24" MaxWidth="700">

            <TextBlock Text="Configuracion" FontSize="24" FontWeight="Bold" />

            <!-- Perfil de usuario -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Perfil de usuario" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Esta informacion ayuda a Alfred a personalizar sus respuestas."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Foto de perfil -->
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left">
                        <PersonPicture x:ConnectionId='16' x:Name="ProfilePicture" Width="72" Height="72"
                                       DisplayName="?" />
                        <StackPanel VerticalAlignment="Center" Spacing="8">
                            <Button x:ConnectionId='17' Content="Cambiar foto"                               
                                    Padding="12,6" />
                            <Button x:ConnectionId='18' x:Name="RemovePictureButton" Content="Quitar foto"
                                                                   Padding="12,6"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:ConnectionId='11' x:Name="UserNameBox" Header="Nombre" PlaceholderText="Tu nombre" />
                    <TextBox x:ConnectionId='12' x:Name="UserAgeBox" Header="Edad" PlaceholderText="Tu edad" />
                    <TextBox x:ConnectionId='13' x:Name="UserOccupationBox" Header="Ocupacion" PlaceholderText="Tu ocupacion" />
                    <TextBox x:ConnectionId='14' x:Name="AboutUserBox" Header="Acerca de ti"
                             PlaceholderText="Informacion adicional..."
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" />

                    <Button x:ConnectionId='15' Content="Guardar perfil" Style="{StaticResource AccentButtonStyle}"
                                                  />
                </StackPanel>
            </Border>

            <!-- Personalizacion del asistente -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Personalizacion" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Configura el comportamiento y estilo de Alfred."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBox x:ConnectionId='6' x:Name="AssistantNameBox" Header="Nombre del asistente"
                             PlaceholderText="Alfred" />

                    <ComboBox x:ConnectionId='7' x:Name="ToneCombo" Header="Tono de respuesta"
                              SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Profesional" Tag="professional" />
                        <ComboBoxItem Content="Amigable" Tag="friendly" />
                        <ComboBoxItem Content="Conciso" Tag="concise" />
                        <ComboBoxItem Content="Detallado" Tag="detailed" />
                        <ComboBoxItem Content="Creativo" Tag="creative" />
                    </ComboBox>

                    <NumberBox x:ConnectionId='8' x:Name="ContextLimitBox" Header="Limite de contexto (mensajes)"
                               Minimum="2" Maximum="100" Value="10"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="1" LargeChange="5" />

                    <TextBox x:ConnectionId='9' x:Name="CustomInstructionsBox" Header="Instrucciones personalizadas"
                             PlaceholderText="Instrucciones adicionales para Alfred..."
                             TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" />

                    <Button x:ConnectionId='10' Content="Guardar personalizacion" Style="{StaticResource AccentButtonStyle}"
                                                          />
                </StackPanel>
            </Border>

            <!-- Seguridad -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Seguridad y privacidad" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Cifrado de datos personales y conversaciones sensibles."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Estado"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='4' x:Name="EncryptionStatusText" Grid.Row="0" Grid.Column="1"
                                   Text="Verificando..." FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Clave"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock x:ConnectionId='5' x:Name="EncryptionKeyText" Grid.Row="1" Grid.Column="1"
                                   Text="" FontSize="13" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:ConnectionId='3' x:Name="EncryptionToggle" Header="Cifrado"
                                      OffContent="Deshabilitado" OnContent="Habilitado"
                                                                    />
                    </StackPanel>

                    <TextBlock Text="El cifrado protege datos personales extraidos por Alfred. Todos los datos se procesan localmente."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- GPU -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="GPU" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:ConnectionId='2' x:Name="GpuStatusText" Text="Detectando..."
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Informacion del sistema -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Acerca de Alfred" FontWeight="SemiBold" FontSize="16" />

                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Alfred 2.0.0 (C++ nativo)"
                                   FontSize="13" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Motor LLM"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="llama.cpp + GGUF"
                                   FontSize="13" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Interfaz"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="WinUI 3 + .NET 9"
                                   FontSize="13" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Privacidad"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="100% local. Sin datos enviados a la nube."
                                   FontSize="13" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="Alfred es un asistente IA local que genera respuestas inteligentes y mantiene tu privacidad. Toda la inferencia se ejecuta en tu dispositivo."
                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

