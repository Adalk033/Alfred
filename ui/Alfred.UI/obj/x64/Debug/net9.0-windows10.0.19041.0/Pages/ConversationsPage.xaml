<Page
    x:Class="Alfred.UI.Pages.ConversationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Conversaciones" FontSize="24" FontWeight="Bold" />
            <Button x:ConnectionId='7' Grid.Column="1" Content="Nueva conversacion"
                    Style="{StaticResource AccentButtonStyle}"
                                              />
        </Grid>

        <!-- Lista de conversaciones -->
        <ListView x:ConnectionId='2' x:Name="ConversationListView" Grid.Row="1"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UpdatedAt}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button x:ConnectionId='5' Grid.Column="1" ToolTipService.ToolTip="Abrir"
                                                           Tag="{Binding Id}"
                                Padding="8,4">
                            <FontIcon Glyph="&#xE8AD;" FontSize="14" />
                        </Button>

                        <Button x:ConnectionId='6' Grid.Column="2" ToolTipService.ToolTip="Eliminar"
                                                             Tag="{Binding Id}"
                                Padding="8,4">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Vacio -->
        <TextBlock x:ConnectionId='3' x:Name="EmptyText" Grid.Row="1"
                   Text="No hay conversaciones"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />
    </Grid>
</Page>

