<Page x:ConnectionId='1'
    x:Class="Alfred.UI.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Alfred.UI.Converters"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Lista de mensajes -->
        <ScrollViewer x:ConnectionId='2' x:Name="ChatScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Padding="24,16,24,8">
            <ItemsRepeater x:ConnectionId='9' x:Name="MessageList"                                >
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                      >
                        <!-- Se usa como placeholder; los items se crean en code-behind -->
                        <TextBlock x:ConnectionId='11'                 TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Panel de bienvenida (visible cuando no hay mensajes) -->
        <StackPanel x:ConnectionId='3' x:Name="WelcomePanel" Grid.Row="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="500">
            <TextBlock Text="Alfred" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AlfredAccent}" />
            <TextBlock Text="Asistente IA local con busqueda en documentos"
                       FontSize="14" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,16,0,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" MinWidth="140">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Preguntame algo" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Sobre tus documentos" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="16,12" MinWidth="140">
                    <StackPanel Spacing="4">
                        <TextBlock Text="100% local" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Privacidad total" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Barra de entrada -->
        <Grid Grid.Row="1" Padding="24,8,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToggleButton x:ConnectionId='6' x:Name="DocSearchToggle" Grid.Column="0" IsChecked="True"
                          ToolTipService.ToolTip="Buscar en documentos" Margin="0,0,8,0"
                          VerticalAlignment="Bottom" Width="38" Height="38">
                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
            </ToggleButton>

            <TextBox x:ConnectionId='7' x:Name="InputBox" Grid.Column="1"
                     PlaceholderText="Escribe tu pregunta..."
                     AcceptsReturn="False"
                     MaxHeight="120"
                     TextWrapping="Wrap"
                                             
                     VerticalAlignment="Bottom" />

            <Button x:ConnectionId='8' x:Name="SendButton" Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                                        Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Width="38" Height="38"
                    IsEnabled="True">
                <FontIcon Glyph="&#xE724;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Indicador de carga -->
        <StackPanel x:ConnectionId='4' x:Name="LoadingIndicator" Grid.Row="1"
                    Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" Margin="0,-32,0,0"
                    Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="16" Height="16" />
            <TextBlock x:ConnectionId='5' x:Name="LoadingText" Text="Pensando..." FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>

