<Window
    x:Class="Alfred.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Alfred.UI.Pages"
    Title="Alfred - Asistente IA Local">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Number188" Invoked="OnSettingsAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de estado del backend (title bar personalizada) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="188" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Alfred" FontWeight="Bold"
                           FontSize="{x:Bind Prefs.SubheaderFontSize, Mode=OneWay}"
                           VerticalAlignment="Center" />
                <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Iniciando..."
                           FontSize="{x:Bind Prefs.CaptionFontSize, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
                <!-- Indicador de tokens del contexto -->
                <StackPanel x:Name="TokenMeterPanel" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTipService.ToolTip="Uso del contexto del modelo">
                    <FontIcon Glyph="&#xE9D9;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="TokenMeterBar" Width="80" Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 VerticalAlignment="Center" />
                    <TextBlock x:Name="TokenMeterText" Text="0 / 0" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" MinWidth="80" />
                </StackPanel>

                <!-- Selector de modelo -->
                <DropDownButton x:Name="ModelPickerButton" VerticalAlignment="Center"
                                Padding="8,4" FontSize="11"
                                ToolTipService.ToolTip="Cambiar o cargar modelo"
                                Click="OnModelPickerOpening">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="ModelStateDot" Width="8" Height="8" CornerRadius="4"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="ModelName" Text="Cargar modelo" FontSize="11"
                                       VerticalAlignment="Center"
                                       MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ModelFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button x:Name="UnloadModelButton" Click="OnUnloadModel"
                        Padding="8,4" FontSize="11" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Detener modelo y liberar GPU/RAM"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71A;" FontSize="12" />
                        <TextBlock Text="Detener modelo" />
                    </StackPanel>
                </Button>
                <Button x:Name="RestartButton" Content="Reiniciar" Click="OnRestartBackend"
                        Style="{StaticResource AccentButtonStyle}" Padding="8,4" FontSize="11"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navegacion con panel lateral -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsPaneOpen="True"
                        SelectionChanged="OnNavigationChanged">

            <NavigationView.PaneCustomContent>
                <Button x:Name="NewConversationButton"
                        Margin="12,4,12,8" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Crear una nueva conversacion vacia"
                        Click="OnNewConversationFromSidebar">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Nueva conversacion" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneCustomContent>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chat" Tag="chat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Conversaciones" Tag="conversations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Modelos" Tag="models">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Configuración" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Navigated="OnContentFrameNavigated"
                   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <DrillInNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Notificacion global (overlay sobre todo el contenido) -->
        <InfoBar x:Name="GlobalNotificationBar" Grid.Row="1"
                 IsOpen="False" IsClosable="True"
                 VerticalAlignment="Top" HorizontalAlignment="Stretch"
                 Margin="60,8,24,0" />
    </Grid>
</Window>
