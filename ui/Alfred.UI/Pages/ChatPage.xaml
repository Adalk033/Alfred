<Page
    x:Class="Alfred.UI.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Alfred.UI.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnFocusInputAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewConversationAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- InfoBar local (no tapa los mensajes) -->
        <InfoBar x:Name="NotificationBar" Grid.Row="0"
                 IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Stretch"
                 Margin="24,8,24,0" />

        <!-- Barra de busqueda local (Ctrl+F) -->
        <Border x:Name="SearchBar" Grid.Row="0"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6"
                Margin="24,8,24,0"
                HorizontalAlignment="Right"
                MinWidth="380">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="14"
                          Margin="6,0,8,0" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         PlaceholderText="Buscar en la conversacion..."
                         BorderThickness="0"
                         TextChanged="OnSearchTextChanged"
                         KeyDown="OnSearchKeyDown" />
                <TextBlock x:Name="SearchCount" Grid.Column="2"
                           VerticalAlignment="Center" Margin="8,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="3" Click="OnSearchPrev" Padding="6,4"
                        ToolTipService.ToolTip="Anterior (Shift+Enter)" AutomationProperties.Name="Coincidencia anterior">
                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                </Button>
                <Button Grid.Column="4" Click="OnSearchNext" Padding="6,4" Margin="4,0,0,0"
                        ToolTipService.ToolTip="Siguiente (Enter)" AutomationProperties.Name="Coincidencia siguiente">
                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                </Button>
                <Button Grid.Column="5" Click="OnSearchClose" Padding="6,4" Margin="4,0,0,0"
                        ToolTipService.ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar busqueda">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Lista de mensajes -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          ViewChanged="OnChatScrollViewChanged"
                          Padding="24,16,24,8">
                <StackPanel x:Name="MessagesPanel" Spacing="12"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>

            <!-- Boton "Ir al final": visible solo cuando el usuario subio -->
            <Button x:Name="JumpToBottomButton"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" Visibility="Collapsed"
                    Click="OnJumpToBottom"
                    Style="{StaticResource AccentButtonStyle}"
                    CornerRadius="16" Padding="12,6"
                    AutomationProperties.Name="Ir al final de la conversacion">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                    <TextBlock Text="Ir al final" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Panel de bienvenida (visible cuando no hay mensajes) -->
        <StackPanel x:Name="WelcomePanel" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{x:Bind Prefs.SectionSpacing, Mode=OneWay}" MaxWidth="600"
                    IsHitTestVisible="False">
            <TextBlock Text="Alfred"
                       FontSize="{x:Bind Prefs.PageTitleFontSize, Mode=OneWay}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AlfredAccent}" />
            <TextBlock Text="Asistente IA local con privacidad total"
                       FontSize="{x:Bind Prefs.BodyFontSize, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,16,0,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="{x:Bind Prefs.CardPadding, Mode=OneWay}"
                        MinWidth="150">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE8BD;" FontSize="20" Foreground="{StaticResource AlfredAccent}" />
                        <TextBlock Text="Respuestas Inteligentes" FontWeight="SemiBold"
                                   FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}" />
                        <TextBlock Text="Precision con contexto local"
                                   FontSize="{x:Bind Prefs.TinyFontSize, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="{x:Bind Prefs.CardPadding, Mode=OneWay}"
                        MinWidth="150">
                    <StackPanel Spacing="4">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{StaticResource AlfredAccent}" />
                        <TextBlock Text="Adjuntar Archivos" FontWeight="SemiBold"
                                   FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}" />
                        <TextBlock Text="PDF, DOCX, TXT y mas"
                                   FontSize="{x:Bind Prefs.TinyFontSize, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="Escribe tu pregunta o adjunta un archivo"
                       FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Indicador de carga y panel de adjuntos -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="24,0,24,4">
            <!-- Indicador de carga -->
            <Border x:Name="LoadingIndicator"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8"
                    Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="420">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing IsActive="True" Width="16" Height="16"
                                  Foreground="{StaticResource AlfredAccent}" />
                    <StackPanel Spacing="0">
                        <TextBlock x:Name="LoadingText" Text="Alfred está pensando..." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="LoadingHint" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Panel de archivos adjuntos -->
            <Border x:Name="AttachmentPanel"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="12,8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE723;" FontSize="14" Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater x:Name="AttachmentList" Grid.Column="1">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Button Grid.Column="2" Click="OnRemoveAllAttachments" Padding="6,4"
                            ToolTipService.ToolTip="Quitar todos los archivos" AutomationProperties.Name="Quitar todos los archivos">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Barra de entrada -->
        <Grid Grid.Row="3" Padding="24,4,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Boton adjuntar archivo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Bottom" Margin="0,0,4,0">
                <Button x:Name="AttachButton"
                        Click="OnAttachFile"
                        ToolTipService.ToolTip="Adjuntar archivo (PDF, DOCX, TXT, etc.)" AutomationProperties.Name="Adjuntar archivo"
                        Width="38" Height="38">
                    <FontIcon Glyph="&#xE723;" FontSize="16" />
                </Button>
            </StackPanel>

            <TextBox x:Name="InputBox" Grid.Column="1"
                     PlaceholderText="Escribe tu pregunta... (Shift+Enter para nueva linea)"
                     FontSize="{x:Bind Prefs.BodyFontSize, Mode=OneWay}"
                     AcceptsReturn="True"
                     MaxHeight="160"
                     TextWrapping="Wrap"
                     KeyDown="OnInputKeyDown"
                     TextChanged="OnInputTextChanged"
                     AllowDrop="True"
                     DragOver="OnDragOver"
                     Drop="OnDrop"
                     VerticalAlignment="Bottom" />

            <Button x:Name="SendButton" Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSendClick" Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Width="38" Height="38"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Enviar" AutomationProperties.Name="Enviar mensaje">
                <FontIcon Glyph="&#xE724;" FontSize="16" />
            </Button>

            <Button x:Name="StopButton" Grid.Column="2"
                    Click="OnStopClick" Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Width="38" Height="38"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    ToolTipService.ToolTip="Detener generación" AutomationProperties.Name="Detener generacion">
                <FontIcon Glyph="&#xE73B;" FontSize="14" Foreground="White" />
            </Button>
        </Grid>

    </Grid>
</Page>
