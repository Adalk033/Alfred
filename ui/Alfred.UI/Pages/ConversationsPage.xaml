<Page
    x:Class="Alfred.UI.Pages.ConversationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="{x:Bind Prefs.PagePadding, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Conversaciones"
                           FontSize="{x:Bind Prefs.PageTitleFontSize, Mode=OneWay}"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CountText"
                           FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="SelectModeToggle"
                              Checked="OnEnterSelectMode" Unchecked="OnExitSelectMode"
                              ToolTipService.ToolTip="Activar seleccion multiple">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE762;" FontSize="14" />
                        <TextBlock Text="Seleccionar" />
                    </StackPanel>
                </ToggleButton>

                <Button x:Name="DeleteSelectedButton"
                        Visibility="Collapsed" IsEnabled="False"
                        Click="OnDeleteSelected"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock x:Name="DeleteSelectedLabel" Text="Eliminar seleccionadas" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Busqueda -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0"
                     PlaceholderText="Buscar conversaciones..."
                     KeyDown="OnSearchKeyDown"
                     TextChanged="OnSearchTextChanged" />
            <Button x:Name="ClearSearchButton" Grid.Column="1"
                    Content="Limpiar" Click="OnClearSearch"
                    Margin="8,0,0,0" Visibility="Collapsed" />
        </Grid>

        <!-- Lista de conversaciones -->
        <ListView x:Name="ConversationListView" Grid.Row="2"
                  SelectionMode="None"
                  IsMultiSelectCheckBoxEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="{Binding CardPadding, Source={StaticResource Prefs}}"
                            Margin="0,3">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" ToolTipService.ToolTip="Fijar / desfijar"
                                    AutomationProperties.Name="Fijar conversacion"
                                    Click="OnTogglePin" Tag="{Binding Id}"
                                    Padding="8,4">
                                <FontIcon Glyph="&#xE718;" FontSize="14" />
                            </Button>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           FontSize="{Binding BodyFontSize, Source={StaticResource Prefs}}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UpdatedAt}"
                                           FontSize="{Binding TinyFontSize, Source={StaticResource Prefs}}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2" ToolTipService.ToolTip="Abrir"
                                    Click="OnOpenConversation" Tag="{Binding Id}"
                                    Padding="8,4">
                                <FontIcon Glyph="&#xE8AD;" FontSize="14" />
                            </Button>

                            <Button Grid.Column="3" ToolTipService.ToolTip="Renombrar"
                                    Click="OnRenameConversation" Tag="{Binding}"
                                    Padding="8,4">
                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                            </Button>

                            <Button Grid.Column="4" ToolTipService.ToolTip="Exportar a Markdown"
                                    AutomationProperties.Name="Exportar a Markdown"
                                    Click="OnExportConversation" Tag="{Binding Id}"
                                    Padding="8,4">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            </Button>

                            <Button Grid.Column="5" ToolTipService.ToolTip="Eliminar"
                                    Click="OnDeleteConversation" Tag="{Binding Id}"
                                    Padding="8,4">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Vacio -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="8" Visibility="Collapsed">
            <FontIcon Glyph="&#xE8F2;" FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No hay conversaciones"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Crea una nueva conversacion para comenzar"
                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
