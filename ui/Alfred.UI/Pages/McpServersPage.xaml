<Page
    x:Class="Alfred.UI.Pages.McpServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Servidores MCP"
                       FontSize="{x:Bind Prefs.PageTitleFontSize, Mode=OneWay}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <FontIcon Glyph="&#xE946;" FontSize="14"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      ToolTipService.ToolTip="MCP servers locales que Alfred puede usar como herramientas externas (filesystem, git, etc.)" />
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}">
                <Run Text="Configurados en " />
                <Run x:Name="RegistryPathText" />
            </TextBlock>

            <Button Grid.Column="1" Click="OnReloadClick"
                    Margin="0,0,8,0"
                    ToolTipService.ToolTip="Recargar desde disco">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="Recargar" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Click="OnSyncClick"
                    Margin="0,0,8,0"
                    ToolTipService.ToolTip="Aplicar cambios y reconectar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontSize="12" />
                    <TextBlock Text="Sincronizar" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Click="OnAddClick"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Anadir server" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Lista -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <StackPanel x:Name="ServerList" Spacing="8" />

                <Border x:Name="EmptyPanel" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20" HorizontalAlignment="Center"
                        MaxWidth="520">
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="22"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Sin servidores MCP configurados"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Pulsa 'Anadir server' para configurar uno (filesystem, git, github, etc.)"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="{x:Bind Prefs.SmallFontSize, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
