<Page
    x:Class="Alfred.UI.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado con titulo y contador -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Historial de preguntas" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="CountText" Grid.Column="1" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Busqueda -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0"
                     PlaceholderText="Buscar en historial..."
                     KeyDown="OnSearchKeyDown" />
            <Button Grid.Column="1" Content="Buscar" Click="OnSearch"
                    Margin="8,0,0,0" />
            <Button x:Name="ClearSearchButton" Grid.Column="2"
                    Content="Limpiar" Click="OnClearSearch"
                    Margin="4,0,0,0" Visibility="Collapsed" />
        </Grid>

        <!-- Lista -->
        <ListView x:Name="HistoryListView" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="16,12" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Question}"
                                               FontWeight="SemiBold" FontSize="14"
                                               TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Answer}" FontSize="13"
                                           TextTrimming="CharacterEllipsis" MaxLines="3"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Acciones por item -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button ToolTipService.ToolTip="Cargar en chat"
                                        Click="OnLoadInChat" Tag="{Binding}"
                                        Padding="6,4">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="13" />
                                </Button>
                                <Button ToolTipService.ToolTip="Eliminar"
                                        Click="OnDeleteEntry" Tag="{Binding}"
                                        Padding="6,4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Estado vacio -->
        <TextBlock x:Name="EmptyText" Grid.Row="2"
                   Text="Sin historial"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- Paginacion -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PrevPageButton" Grid.Column="0" Content="Anterior"
                    Click="OnPrevPage" IsEnabled="False" Padding="12,6" />
            <TextBlock x:Name="PageInfoText" Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="NextPageButton" Grid.Column="2" Content="Siguiente"
                    Click="OnNextPage" IsEnabled="False" Padding="12,6" />
        </Grid>
    </Grid>
</Page>
