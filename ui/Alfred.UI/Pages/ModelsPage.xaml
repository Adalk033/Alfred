<Page
    x:Class="Alfred.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Modelos GGUF" FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,16" />

            <!-- Estado actual -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Estado actual" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="LLM" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LlmStatus" Text="Cargando..." FontSize="13" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buscar y descargar modelo desde HuggingFace -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Descargar modelo desde HuggingFace" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Pega la URL o nombre del modelo (ej. google/gemma-3-4b-it, openai/gpt-oss-20b) y se buscaran las versiones GGUF disponibles."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Barra de busqueda -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="google/gemma-3-4b-it  o  https://huggingface.co/openai/gpt-oss-20b"
                                 VerticalAlignment="Center"
                                 KeyDown="OnSearchKeyDown" />

                        <Button x:Name="SearchButton" Grid.Column="1" Content="Buscar GGUF"
                                Click="OnSearchClick" Padding="12,6"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- Indicador de busqueda -->
                    <ProgressBar x:Name="SearchProgress" IsIndeterminate="True"
                                 Height="4" Visibility="Collapsed" />
                    <TextBlock x:Name="SearchStatusText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />

                    <!-- Resultados: Lista de repos encontrados -->
                    <StackPanel x:Name="RepoResultsPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="RepoResultsHeader" Text="Repositorios GGUF encontrados:"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ListView x:Name="RepoListView" SelectionMode="Single"
                                  SelectionChanged="OnRepoSelected" MaxHeight="140" />
                    </StackPanel>

                    <!-- Archivos GGUF del repo seleccionado -->
                    <StackPanel x:Name="FileResultsPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="FileResultsHeader" Text="Archivos disponibles:"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <ListView x:Name="FileListView" SelectionMode="None" MaxHeight="350">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Quantization}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding SizeGb}" />
                                            <Run Text=" GB" />
                                        </TextBlock>

                                        <Button Grid.Column="2" Content="Descargar"
                                                Click="OnDownloadGgufFile"
                                                Tag="{Binding}"
                                                Padding="10,4" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Progreso de descarga -->
                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100"
                                 Height="4" Visibility="Collapsed" />
                    <TextBlock x:Name="DownloadProgressText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <Button x:Name="CancelDownloadButton" Content="Cancelar descarga"
                            Click="OnCancelDownload" Padding="10,4"
                            Visibility="Collapsed" />

                    <TextBlock x:Name="ModelsDirText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Lista de modelos disponibles en disco -->
            <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="Modelos disponibles en disco" FontWeight="SemiBold" FontSize="16" />
            </StackPanel>

            <ListView x:Name="ModelListView" Grid.Row="4" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding Path}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding SizeGb}" />
                                <Run Text=" GB" />
                            </TextBlock>

                            <Button Grid.Column="2" Content="Usar como LLM"
                                    Click="OnChangeModel" Tag="{Binding Path}"
                                    Padding="12,4" VerticalAlignment="Center" />

                            <Button Grid.Column="3" Content="Eliminar"
                                    Click="OnDeleteModel" Tag="{Binding Name}"
                                    Padding="12,4" VerticalAlignment="Center"
                                    Foreground="#E74C3C" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="4"
                       Text="No se encontraron archivos GGUF en disco"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <!-- Configuracion del modelo LLM -->
            <Border Grid.Row="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16,12" Margin="0,24,0,0">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Configuracion del modelo" FontWeight="SemiBold" FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Config mode badge -->
                        <Border x:Name="ConfigModeBadge" Grid.Column="2"
                                CornerRadius="4" Padding="8,3"
                                Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ConfigModeText" Text="Custom" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="Los parametros de carga (contexto, GPU, batch, hilos) requieren detener y recargar el modelo. Los parametros de sampling (temperatura, top_p, max tokens) se aplican inmediatamente."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <InfoBar x:Name="ConfigInfoBar" IsOpen="False" IsClosable="True"
                             Severity="Informational" />

                    <!-- Parametros de carga -->
                    <TextBlock Text="Parametros de carga (requieren reinicio)" FontWeight="SemiBold"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox x:Name="NCtxBox" Grid.Row="0" Grid.Column="0"
                                   Header="Ventana de contexto (n_ctx)"
                                   Minimum="512" Maximum="131072"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="512" LargeChange="2048" />

                        <NumberBox x:Name="NGpuLayersBox" Grid.Row="0" Grid.Column="1"
                                   Header="Capas GPU (n_gpu_layers)"
                                   Minimum="0" Maximum="999"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="10" />

                        <NumberBox x:Name="NBatchBox" Grid.Row="1" Grid.Column="0"
                                   Header="Tamano de batch (n_batch)"
                                   Minimum="1" Maximum="8192"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="64" LargeChange="256" />

                        <NumberBox x:Name="NThreadsBox" Grid.Row="1" Grid.Column="1"
                                   Header="Hilos CPU (0 = auto)"
                                   Minimum="0" Maximum="256"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="4" />
                    </Grid>

                    <!-- Parametros de sampling -->
                    <TextBlock Text="Parametros de sampling (se aplican en caliente)"
                               FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <NumberBox x:Name="TemperatureBox" Grid.Row="0" Grid.Column="0"
                                   Header="Temperatura"
                                   Minimum="0" Maximum="2"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="0.05" LargeChange="0.1" />

                        <NumberBox x:Name="TopPBox" Grid.Row="0" Grid.Column="1"
                                   Header="Top P"
                                   Minimum="0" Maximum="1"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="0.05" LargeChange="0.1" />

                        <NumberBox x:Name="MaxTokensBox" Grid.Row="1" Grid.Column="0"
                                   Header="Max tokens"
                                   Minimum="1" Maximum="131072"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="256" LargeChange="1024" />

                        <NumberBox x:Name="SeedBox" Grid.Row="1" Grid.Column="1"
                                   Header="Seed (-1 = aleatorio)"
                                   Minimum="-1" Maximum="999999999"
                                   SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="100" />
                    </Grid>

                    <!-- Botones -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="SaveConfigButton" Click="OnSaveConfig"
                                Style="{StaticResource AccentButtonStyle}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="Guardar configuracion" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AutoTuneButton" Click="OnAutoTune"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE945;" FontSize="14" />
                                <TextBlock Text="Auto Tune (Recommended)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetConfigButton" Click="OnResetConfig"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Restore Defaults" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Hardware info (visible tras auto-tune) -->
                    <TextBlock x:Name="HardwareInfoText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
