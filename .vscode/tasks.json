{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "Visual Studio 17 2022",
                "-DALFRED_CUDA=ON",
                "-DALFRED_CUDA_ARCH=89",
                "-DCMAKE_CUDA_COMPILER=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2/bin/nvcc.exe",
                "-DCUDAToolkit_ROOT=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2",
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build All",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake: Configure",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Release"
            ],
            "group": "build",
            "dependsOn": "CMake: Configure",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--target",
                "clean"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "UI: Build Debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "ui/Alfred.UI/Alfred.UI.csproj",
                "-c",
                "Debug",
                "-p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "UI: Build Release",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "ui/Alfred.UI/Alfred.UI.csproj",
                "-c",
                "Release",
                "-p:Platform=x64"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "UI: Run",
            "type": "shell",
            "command": "ui/Alfred.UI/bin/x64/Debug/net9.0-windows10.0.19041.0/Alfred.UI.exe",
            "dependsOn": "UI: Build Debug",
            "problemMatcher": []
        }
    ]
}